NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://drive.example.com
PUBLIC_HOST=drive.example.com
POSTGRES_PASSWORD=replace-this-with-a-long-random-password
DATABASE_URL=postgresql://switch_drive:replace-this-with-a-long-random-password@postgres:5432/switch_drive
GOOGLE_CLIENT_ID=apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Exactly 32 random bytes encoded in base64, e.g. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# At least 32 random bytes, e.g. `openssl rand -base64 32`
COOKIE_SECRET=replace-with-a-random-secret
